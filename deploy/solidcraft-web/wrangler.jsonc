{
  // Hosts a SolidCraft browser build on Cloudflare.
  // Small files are Workers static assets; the WebAssembly binary (166 MB raw,
  // 32 MB Brotli) is over the 25 MiB static-asset limit, so it lives in R2.
  "name": "solidcraft-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-24",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "WASM", "bucket_name": "solidcraft-web-wasm" }]
}
