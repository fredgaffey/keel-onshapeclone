+++ b/crates/ui-egui/src/control.rs
@@ -658,6 +658,7 @@ fn dispatch(app: &mut SolveApp, ctx: &egui::Context, method: &str, p: &Value) ->
         // A host that keeps the files itself (an editing embed, #8517).
         "document.export" => wrap(crate::documents::export(app)),
