+    #[test]
+    fn opacity_and_colour_show_live_and_cancel_puts_them_back() {
+        let mut h = crate::scenario::Harness::new();
+        h.app.run("solid.box", json!({"length":10,"width":10,"height":10})).unwrap();
+        h.app.run("appearance.assign", json!({"bodies":["Body1"],"color":"#abcdef","opacity":1.0})).unwrap();
+        let undo_before = h.app.session.undo.len();
+        for ok in [false, true] {
+            h.app.session.selection = vec![Sel::Body { name: "Body1".into() }];
+            h.app.start("appearance.assign");
+            h.frames(2);
+            for opacity in [0.8, 0.5, 0.3] {
+                let Kind::Appearance(k) = &mut h.app.dialog.as_mut().unwrap().kind else { panic!("appearance dialog") };
+                k.opacity = opacity;
+                k.touched = true;
+                h.frames(1);
+                assert_eq!(h.app.session.doc.appearances.bodies["Body1"].opacity, opacity, "live while the dialog is open");
+                assert_eq!(h.app.session.undo.len(), undo_before + 1, "one step, not one per change");
+            }
+            h.step(&json!({"key": if ok { "Enter" } else { "Escape" }})).unwrap();
+            assert!(h.app.dialog.is_none());
+            let kept = h.app.session.doc.appearances.bodies["Body1"].opacity;
+            if ok {
+                assert_eq!(kept, 0.3, "OK keeps the look");
+                assert_eq!(h.app.session.undo.len(), undo_before + 1, "as one undo step");
+            } else {
+                assert_eq!(kept, 1.0, "Cancel puts it back");
+                assert_eq!(h.app.session.undo.len(), undo_before, "and leaves no step");
+            }
+        }
+    }
+
