+/// Show the dialog's look on the picked objects as it changes (the opacity slider, the colour
+/// picker, the surface settings), not only on Apply or OK. Each change goes back to the
+/// checkpoint taken before the first one and applies the new look, so the history holds one
+/// step: OK keeps it (and runs nothing more), Cancel goes back to the checkpoint.
+fn live_preview(app: &mut SolveApp, k: &mut Ap, picked: &[Sel]) {
+    if !k.touched || k.remove_override || k.local.materials {
+        return;
+    }
+    let want = selected_params(k, picked);
+    if want.as_ref() == k.live.as_ref().map(|(_, p)| p) {
+        return;
+    }
+    if let Some((id, _)) = k.live.take() {
+        let _ = app.session.restore_checkpoint(id);
+    }
+    k.applied = None;
+    let Some(p) = want else { return };
+    let id = app.session.checkpoint();
+    match app.run("appearance.assign", p.clone()) {
+        Ok(_) => {
+            k.applied = Some(p.clone());
+            k.live = Some((id, p));
+        }
+        // A look that can't be applied yet (no objects it fits): no preview; Apply says why.
+        Err(_) => {
+            let _ = app.session.restore_checkpoint(id);
+        }
+    }
+}
+
+/// Undo a live preview's step (before Apply, Remove override or Cancel run their own).
+pub(crate) fn end_preview(app: &mut SolveApp, k: &mut Ap) {
+    if let Some((id, _)) = k.live.take() {
+        let _ = app.session.restore_checkpoint(id);
+        k.applied = None;
+    }
+}
