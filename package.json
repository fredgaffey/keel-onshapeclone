{
  "name": "keel",
  "version": "0.1.0",
  "description": "Keel - collaborative browser CAD on SolidCraft, hosted on Cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "stage-cad": "scripts/stage-cad.sh",
    "db:local": "wrangler d1 migrations apply keel --local",
    "dev": "wrangler dev --port 8787 --local-upstream 127.0.0.1:8787 --test-scheduled",
    "e2e": "node tests/e2e.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "test:agents": "node tests/agents.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "wrangler": "^4.103.0"
  }
}
