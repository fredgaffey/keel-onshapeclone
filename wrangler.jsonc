// Keel on Cloudflare: one Worker serves the site and the API.
//   D1 "keel"        accounts, sessions, the document list, sharing, versions
//   R2 "keel-files"  version snapshots, and SolidCraft's WebAssembly (too big for static assets)
//   Durable Objects  DocRoom: one per document, holds the live design and the editing session
// See README.md › "Deploying" for the one-time setup.
{
  "name": "keel",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-24",
  "routes": [{ "pattern": "keel.pebnum.com", "custom_domain": true }],
  "workers_dev": true, // keep the *.workers.dev address too
  // Hourly: delete loose documents past their deletion date (LOOSE_DAYS).
  "triggers": { "crons": ["17 * * * *"] },
  // Loose documents can be made without an account, so limit how fast one address can make them.
  "ratelimits": [
    { "name": "LOOSE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "keel", "database_id": "6ffaff05-a1de-4126-8bf9-c82216b07f47", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "keel-files" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "DocRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "vars": {
    // "open": anyone who reaches the site can make an account. "closed": none can (put the site
    // behind Cloudflare Access and make accounts while it's open, or switch it back briefly).
    "SIGNUP": "open",
    // "open": anyone (an agent, say) can make a loose document with no account: it gets a key
    // instead, and is deleted LOOSE_DAYS days after it's made. "closed": accounts only.
    "LOOSE": "open",
    "LOOSE_DAYS": "30"
  }
}
